{
    "name": "kamandlou/laravel-icmp",
    "description": "Structured ICMP ping probes for Laravel.",
    "keywords": ["laravel", "icmp", "ping", "network"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Kamandlou\\LaravelIcmp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kamandlou\\LaravelIcmp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kamandlou\\LaravelIcmp\\IcmpServiceProvider"
            ],
            "aliases": {
                "Icmp": "Kamandlou\\LaravelIcmp\\Facades\\Icmp"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
